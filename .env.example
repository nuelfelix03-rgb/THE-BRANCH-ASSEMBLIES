# === SECURITY ===
SECRET_KEY=generate-a-random-secret-key-here
FLASK_ENV=production
SESSION_COOKIE_SECURE=True

# === DATABASE ===
# Local development (default):
DATABASE_URL=sqlite:///church.db

# Production (Render) - Internal Database URL (use when the web service and the
# PostgreSQL are in the SAME region; host is the bare internal id like dpg-xxx-a):
# DATABASE_URL=postgresql://user:password@dpg-d9jnbnj7uimc739tmlq0-a:5432/church_db

# Production (Render) - External Database URL (from Render dashboard -> PostgreSQL
# -> Info -> Connections; required when the DB is in another region / used by tools
# outside Render; requires SSL):
# DATABASE_URL=postgresql://user:password@dpg-d9jnbnj7uimc739tmlq0-a.oregon-postgres.render.com:5432/church_db?sslmode=require

# Production (Neon):
# DATABASE_URL=postgresql://user:password@ep-cool-name.us-east-2.aws.neon.tech:5432/church_db?sslmode=require

# === MAIL (for password reset) ===
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# === SMS (optional, for text-message sending) ===
SMS_API_URL=
SMS_API_KEY=

# === SERVER ===
PORT=8000
PREFERRED_URL_SCHEME=https
SERVER_NAME=your-app-domain.com
WEB_CONCURRENCY=4
LOG_LEVEL=info
